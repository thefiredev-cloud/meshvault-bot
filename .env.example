NODE_ENV=development
DATABASE_URL=postgres://meshbot:meshbot@127.0.0.1:5433/meshbot
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Optional separate service credential; defaults to BETTER_AUTH_SECRET when empty.
SANDBOX_SUPERVISOR_TOKEN=
SANDBOX_PROVIDER=docker
AGENT_RUNTIME=hermes
WAKEUP_DRIVER=graphile
# Pause E2B (or stop Docker) computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
# Default model path: Qwen via DashScope / compatible OpenAI API.
# Set either key. Do not commit a real key.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
# Optional. Default: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
DASHSCOPE_BASE_URL=
# Optional. OpenRouter remains a first-class Pi provider.
OPENROUTER_API_KEY=
# Optional. Deployment-owned OpenAI-compatible gateway for local models.
# List only model IDs the configured endpoint actually serves.
MESHBOT_GATEWAY_URL=
MESHBOT_GATEWAY_KEY=
MESHBOT_GATEWAY_MODELS=
PI_DEFAULT_PROVIDER=qwen
PI_DEFAULT_MODEL=qwen-plus
E2B_API_KEY=
# Optional. Stripe Checkout for POST /api/create-checkout. Missing → 503, no charge.
STRIPE_SECRET_KEY=
# Optional. Approved Stripe HTTPS host only. Used instead of creating a session.
MESHVAULT_SKILLS_PAYMENT_LINK=
# Optional. Success/cancel origin for Stripe Checkout Sessions.
MESHVAULT_CHECKOUT_ORIGIN=https://meshvault.ai
# Optional. Resend for POST /api/install-lead. Missing → 503, email contact@meshvault.ai.
RESEND_API_KEY=
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
