{
  "name": "@meshbot/desktop",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && cp src/preload.cjs src/connect.html src/connect.js src/bots.html src/bots.js dist/",
    "pack": "pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm build && electron-builder --dir",
    "release:mac:check": "node scripts/check-macos-release.mjs",
    "release:mac:test": "node scripts/check-macos-release.mjs --self-test",
    "release:mac": "pnpm release:mac:check && pnpm build && electron-builder --mac --config electron-builder.release.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src"
  },
  "dependencies": {
    "@meshbot/contracts": "workspace:*"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.meshbot.desktop",
    "productName": "MeshVault",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
