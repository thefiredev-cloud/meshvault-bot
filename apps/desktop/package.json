{
  "name": "@meshbot/desktop",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "MeshVault desktop client",
  "author": "The Fire Dev LLC",
  "homepage": "https://meshvault.ai",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "node scripts/copy-static.mjs sync && tsc -p tsconfig.json && node scripts/copy-static.mjs static",
    "pack": "pnpm build && electron-builder --mac --win --linux --publish never",
    "pack:linux": "pnpm build && electron-builder --linux --publish never",
    "pack:mac": "pnpm build && electron-builder --mac --publish never",
    "pack:win": "pnpm build && electron-builder --win --publish never",
    "pack:dir": "pnpm build && electron-builder --dir",
    "release:mac:check": "node scripts/check-macos-release.mjs",
    "release:mac:test": "node scripts/check-macos-release.mjs --self-test",
    "release:mac": "pnpm release:mac:check && pnpm build && electron-builder --mac --config electron-builder.release.mjs",
    "check": "node scripts/copy-static.mjs sync && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src"
  },
  "dependencies": {
    "@meshbot/contracts": "workspace:*"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.meshvault.desktop",
    "productName": "MeshVault",
    "executableName": "meshvault",
    "artifactName": "MeshVault-${version}-${platform}-${arch}.${ext}",
    "copyright": "Copyright (c) 2026 The Fire Dev LLC. Apache-2.0.",
    "publish": null,
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MeshVault"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "maintainer": "The Fire Dev LLC",
      "vendor": "The Fire Dev LLC",
      "synopsis": "MeshVault desktop client",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
