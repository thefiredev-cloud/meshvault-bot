---
import { CHANGELOG_URL, DOCS_URL, GITHUB_URL, INBOX_ZERO_URL, RAKAZO_UPSTREAM_URL } from "../site";
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo />
    <span class="site-footer__legal">
      © 2026 Tanner Osterkamp · Apache-2.0 · fork of
      <a href={RAKAZO_UPSTREAM_URL} target="_blank" rel="noreferrer">Rakazo</a>
      by
      <a href={INBOX_ZERO_URL} target="_blank" rel="noreferrer">Inbox Zero Inc.</a>
    </span>
  </div>
  <nav class="site-footer__links" aria-label="Footer">
    <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
    <a href={DOCS_URL} target="_blank" rel="noreferrer">Docs</a>
    <a href={CHANGELOG_URL} target="_blank" rel="noreferrer">Changelog</a>
    <a href="/privacy">Privacy</a>
  </nav>
</footer>
