---
import { BotAvatar } from "@meshbot/ui-web";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { ProductDemo } from "../components/ProductDemo";
import { DEMO_ROSTER } from "../demo";
import { fetchGithubStars, formatStarCount } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  DOCS_URL,
  FOUNDING_INSTALL_HREF,
  GITHUB_URL,
  SITE_DESCRIPTION,
  SKILL_PACK_CHECKOUT_HREF,
  WAITLIST_HREF,
} from "../site";

const stars = await fetchGithubStars();
const starsLabel = stars === null ? "Star" : formatStarCount(stars);
---

<BaseLayout title="MeshVault" description={SITE_DESCRIPTION}>
  <div class="container">
    <Header starsLabel={starsLabel} />

    <main id="main">
      <section class="hero">
        <a class="hero__pill" href="#selfhost">
          <span class="hero__badge">Apache-2.0</span>
          <span>MeshVault is the model plus the application plus compute.</span>
        </a>
        <h1>MeshVault</h1>
        <p class="lead">
          MeshVault is the model plus the application plus compute. That is the company, the offer, and the message. We sell all three as one product.
        </p>
        <div class="hero__actions">
          <Button href={GITHUB_URL} external>View on GitHub</Button>
          <Button href={GITHUB_URL} variant="secondary" external>Star on GitHub</Button>
        </div>
      </section>

      <section id="demo">
        <ProductDemo client:load />
      </section>

      <section id="selfhost" class="section">
        <div class="section-intro">
          <div class="eyebrow">Self-hosted</div>
          <h2 class="section-heading">The computer is yours</h2>
          <p class="section-copy">
            Every bot gets a sandboxed browser and shell. Self-host the runtime in your Docker environment, then
            connect the model and SaaS services you choose.
          </p>
        </div>
        <div class="card-grid-3">
          <article class="feature-card">
            <h3>Any model, your key</h3>
            <p>Point a bot at Qwen, Claude, GPT, Grok, or a local OpenAI-compatible gateway. Swap per bot — the cheap one triages, the smart one writes.</p>
          </article>
          <article class="feature-card">
            <h3>Scheduled routines</h3>
            <p>Save a prompt with a cron schedule and timezone, then let the bot run it in the same thread.</p>
          </article>
          <article class="feature-card">
            <h3>Inline approvals</h3>
            <p>When a protected action needs your decision, approve or deny it in the same chat before it runs.</p>
          </article>
        </div>
      </section>

      <section id="roster" class="section">
        <div class="section-intro">
          <div class="eyebrow">Bot Templates</div>
          <h2 class="section-heading">Give each bot a job</h2>
          <p class="section-copy">
            Give a bot a name, a job, and instructions, then start its first task from the same chat.
          </p>
        </div>
        <div class="card-grid-4">
          {DEMO_ROSTER.map((bot) => (
            <article class="roster-card">
              <BotAvatar color={bot.color} size={30} />
              <h3>{bot.name}</h3>
              <p>{bot.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="open-source" class="section">
        <div class="section-intro">
          <div class="eyebrow">Open source</div>
          <h2 class="section-heading">Apache-2.0 to self-host. Optional extras elsewhere.</h2>
          <p class="section-copy">
            MeshVault is the model plus the application plus compute. That is the company, the offer, and the message. We sell all three as one product.
            The application is Apache-2.0 licensed and can run on your own machine with the model connections
            you choose. The source and self-hosting setup are in the repo. Native Mac and iPhone clients are
            in development and are not released.
          </p>
        </div>
        <div class="comparison-grid">
          <article class="comparison-card">
            <h3>Self-host</h3>
            <p class="comparison-meta">Available today</p>
            <div class="comparison-list">
              <div>Docker runner and sandboxed browser</div>
              <div>Bring your own model keys</div>
              <div>Routines and bot memory</div>
              <div>Multiple bots without seat licensing</div>
              <div>Community support on GitHub</div>
            </div>
            <div class="comparison-actions">
              <Button href={GITHUB_URL} size="sm" external>Star on GitHub</Button>
              <Button href={DOCS_URL} variant="secondary" size="sm" external>Read the docs</Button>
            </div>
          </article>
          <article class="comparison-card comparison-card--muted">
            <div class="comparison-kicker">
              <h3>Cloud</h3>
              <span class="comparison-badge">Coming soon</span>
            </div>
            <p class="comparison-meta">Bring your own keys, we run the computers</p>
            <div class="comparison-list comparison-list--muted">
              <div>Managed sandboxes, always on</div>
              <div>Your keys, your model spend</div>
              <div>Same bots, same routines, no migration</div>
            </div>
            <div class="comparison-actions">
              <Button href={WAITLIST_HREF} variant="secondary" size="sm">Join the waitlist</Button>
            </div>
          </article>
        </div>
      </section>

      <section id="skills" class="section">
        <div class="section-intro">
          <div class="eyebrow">Optional</div>
          <h2 class="section-heading">A $49 skills pack, or a founding install</h2>
          <p class="section-copy">
            The runtime stays free to clone and self-host. The pack is a one-time Markdown set sold by
            FireDev LLC dba MeshVault — not a seat license and not required to run the application. Native Mac
            and iPhone clients are not in the App Store or available as a public download yet.
          </p>
        </div>
        <div class="comparison-grid">
          <article class="comparison-card">
            <h3>Agent Skills Starter Pack</h3>
            <p class="comparison-meta">$49 · one-time</p>
            <div class="comparison-list">
              <div>Markdown skills, runbooks, and worked examples</div>
              <div>Checkout on Stripe; you complete payment yourself</div>
              <div>Signed download link by email, valid seven days</div>
              <div>A smaller MIT set stays free on GitHub</div>
            </div>
            <div class="comparison-actions">
              <Button href={SKILL_PACK_CHECKOUT_HREF} size="sm" external>Buy the $49 pack</Button>
            </div>
          </article>
          <article class="comparison-card">
            <h3>Founding install</h3>
            <p class="comparison-meta">Quoted after a short audit</p>
            <div class="comparison-list">
              <div>Managed install on hardware you own</div>
              <div>The runtime and data stay yours after we leave</div>
              <div>Email contact@meshvault.ai — there is no fake inbox</div>
            </div>
            <div class="comparison-actions">
              <Button href={FOUNDING_INSTALL_HREF} variant="secondary" size="sm">Request a founding install</Button>
            </div>
          </article>
        </div>
      </section>

      <section class="stats-band">
        <div>
          <h2>Meet your first bot</h2>
          <p>Clone the repo, add a model key, and hand it something you have been putting off.</p>
          <div class="cta-actions">
            <Button href={GITHUB_URL} external>View on GitHub</Button>
            <Button href={GITHUB_URL} variant="secondary" external>Star on GitHub</Button>
          </div>
        </div>
        <div class="stats-grid">
          <div>
            <div class="stat-value">{starsLabel}</div>
            <div class="stat-label">GitHub stars</div>
          </div>
          <div>
            <div class="stat-value">Apache-2.0</div>
            <div class="stat-label">License</div>
          </div>
          <div>
            <div class="stat-value">Open source</div>
            <div class="stat-label">No seats, no gates</div>
          </div>
          <div>
            <div class="stat-value">Self-host</div>
            <div class="stat-label">Your machine</div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
